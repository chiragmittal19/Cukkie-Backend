# =============================================================================
# Rust & Cargo Build Artifacts
# =============================================================================
# Compiled files and executables
debug
debug/
target
target/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows debugging information
*.pdb

# Cargo mutants testing data
**/mutants.out*/

# rustc stack traces when hitting an internal compiler error
rustc-ice-*.txt

# Profiling & Code Coverage
*.profraw
*.profdata
coverage/
lcov.info
tarpaulin-report.*

# =============================================================================
# Environment & Secrets
# =============================================================================
.env
.env.*
*.env
!.env.example
!.env.template

# Certificates and cryptographic keys
*.pem
*.key
*.cert
*.crt

# =============================================================================
# IDE & Editor Files
# =============================================================================
# JetBrains / RustRover
.idea/
*.iml
*.ipr
*.iws
cmake-build-*/

# Visual Studio Code
.vscode/
*.code-workspace

# Editor temporary, swap, and backup files
*.swp
*.swo
*~
*.bak
.#*
*.sublime-project
*.sublime-workspace

# =============================================================================
# Operating System Files
# =============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# =============================================================================
# Runtime Data, Logs & Temporary Files
# =============================================================================
*.log
logs/
*.sqlite
*.sqlite3
*.db
tmp/
